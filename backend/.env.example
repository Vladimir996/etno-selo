PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=etno_selo_raonica
# Potrebno samo za hostovane baze koje zahtevaju SSL (npr. Aiven) — sadržaj CA sertifikata (ca.pem)
DB_CA_CERT=

# Poreklo sa kojih frontend sme da zove ovaj API (odvojeno zarezom)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Nasumičan, dovoljno dug string — npr: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
